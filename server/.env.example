# Allowlist policy: document every server env read here (one-line purpose). Split:
# - Infrastructure / secrets: connectivity, keys, NODE_ENV, host-injected PORT, CORS/brand/sentinel URLs.
# - Ops overrides: optional *MS, *LIMIT, tuning JSON — defaults live in server/src/config/ (SYSTEM_DEFAULTS, *-limits.ts).
# Full rules: docs/ARCHITECTURE.md#strict-layer-boundaries-operational-policy
#            docs/DEPLOYMENT.md#environment-layers-infrastructure-vs-ops-overrides

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
ANTHROPIC_API_KEY=sk-ant-...
PORT=3001

# Deprecated: comma-separated emails promoted to consultant on first login. Prefer
# `consultant_email_allowlist` rows (manage via GET/POST/DELETE /api/platform/consultant-allowlist for platform admins).
# CONSULTANT_EMAILS=you@company.com
NODE_ENV=development
# Intake: set to 0/false/off to empty `nextRecommended` on API resolver (ADR Phase F).
# INTAKE_NEXT_RECOMMENDED_ENABLED=1
# Required when NODE_ENV=production: secret for hashing client IPs in snapshot_guest_sessions (no raw IPs stored).
# SNAPSHOT_GUEST_IP_SALT=generate-a-long-random-string
# CORS: comma-separated browser origins (scheme + host; optional port). Merged with FRONTEND_URL in production.
# ALLOWED_ORIGINS=https://www.example.com,https://example.com
# FRONTEND_URL=https://www.example.com

# Required when NODE_ENV=production: HTTPS marketing/site origin for crawler user-agents (no trailing slash).
# GLC_PUBLIC_SITE_URL=https://www.example.com
# Optional: hostname or https URL for PDF/report branding if GLC_PUBLIC_SITE_URL cannot be parsed (fix URL in prod instead).
# GLC_BRAND_HOST_FALLBACK=

# Collectors: HTTP timeouts and truncation (optional).
# COLLECTOR_FETCH_TIMEOUT_MS=10000
# COLLECTOR_HEADER_PREVIEW_MAX=200
# COLLECTOR_SEO_FETCH_TIMEOUT_MS=15000
# COLLECTOR_SEO_ROBOTS_CONTENT_MAX=2000
# SITEMAP_FETCH_TIMEOUT_MS=25000

# Full-audit crawler (phase 0); max pages clamped to 1..100.
# CRAWLER_MAX_PAGES=20
# CRAWLER_PAGE_TIMEOUT_MS=15000
# CRAWLER_TOTAL_BUDGET_MS=90000

# Public snapshot route tuning (optional).
# SNAPSHOT_GUEST_HEADER_MAX_LEN=2000
# SNAPSHOT_UX_SUMMARY_MAX_CHARS=280
# SNAPSHOT_COMPETITOR_TIMEOUT_MS=3000

# Token cost estimates: merge JSON object over built-in per-model USD/MTok rates.
# ANTHROPIC_PRICING_JSON={"claude-sonnet-4-20250514":{"input":3,"output":15}}

# Industry × domain score weights: JSON merged over defaults in server/src/config/industry-weights.ts (keys = normalized industry slug).
# INDUSTRY_WEIGHTS_JSON={"healthcare":{"security_compliance":1.7,"seo_digital":1.1}}

# Public marketing / white-label (optional). Exposed at GET /api/public/brand (no auth).
# PUBLIC_BRAND_NAME=GLC Tech
# PUBLIC_SUPPORT_EMAIL=contact@example.com
# PUBLIC_BRAND_LEGAL_LINE=City · Country · Legal name

# PDF report theme (optional hex #RRGGBB) and locale for date formatting.
# PDF_LOCALE=en-GB
# PDF_COLOR_NAVY=#0F1729
# PDF_COLOR_GREEN=#0ECF82

# Snapshot guest cookie (optional).
# SNAPSHOT_GUEST_COOKIE_NAME=glc_snapshot_guest
# SNAPSHOT_GUEST_SESSION_MAX_AGE_SEC=7776000

# --- White-label and cross-stack parity ---
# Optional: custom sentinel URL for legacy rows without audits.no_public_website (defaults to dev-brand placeholder).
# When overriding, server and Vite should use the same value so isNoPublicWebsiteUrl() matches on both sides.
# NO_PUBLIC_WEBSITE_URL=https://your-product.placeholder/no-public-website
# VITE_NO_PUBLIC_WEBSITE_URL=<same as NO_PUBLIC_WEBSITE_URL>   # Vercel / .env.local
# See docs/DEPLOYMENT.md — "Server and SPA variables that must match".

# Snapshot tiered fetch (optional): Accept-Language and path heuristics (defaults in server/src/config/snapshot-fetch-heuristics.ts).
# SNAPSHOT_FETCH_ACCEPT_LANGUAGE=en,es,de,fr,nl,pt,it,pl,ru,uk,ja,zh-CN,zh;q=0.9
# SNAPSHOT_HEAD_ACCEPT_LANGUAGE=en,es;q=0.9
# SNAPSHOT_PATH_HINT_REGEX_JSON=["/about","/contact","/pricing"]
# SNAPSHOT_ROBOTS_FALLBACK_PATHS_JSON=["/about","/contact","/pricing"]

# Pipeline alert rolling window (optional; minutes 1–1440, default 15).
# ALERT_WINDOW_MINUTES=15

# Snapshot audit scoring: multiplier for rule status "partial" (default 0.5; must be 0 < n <= 1).
# SNAPSHOT_PARTIAL_SCORE_FACTOR=0.5

# Optional prefix for Claude circuit-breaker Redis key when sharing Redis (default key cb:claude:failures).
# REDIS_KEY_PREFIX=mytenant

# GET /api/audits pagination (optional).
# AUDITS_LIST_DEFAULT_LIMIT=50
# AUDITS_LIST_MAX_LIMIT=200

# Telegram alerts (optional). Override API host only if traffic must go through a proxy.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_API_BASE=https://api.telegram.org

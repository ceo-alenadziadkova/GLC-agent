# Server environment — curated operator template (see also docs/DEPLOYMENT.md).
#
# Being listed here does NOT mean a value should be configured via env in normal operation.
# Split:
#
# 1) Infrastructure & secrets — URLs, keys, NODE_ENV, host PORT, Redis, Sentry, Telegram, etc.
#    These belong in env because they differ per deployment or must stay secret.
#
# 2) Deploy wiring & white-label — FRONTEND_URL, GLC_PUBLIC_SITE_URL, ALLOWED_ORIGINS, PUBLIC_* —
#    URLs and strings that identify this install.
#
# 3) Product numbers (timeouts, limits, crawler/collector caps, snapshot token TTL, PDF theme, …)
#    live in TypeScript: server/src/config/system-defaults.ts and focused modules — not in env.
#
# Process: when adding a new process.env read, document it here (or in DEPLOYMENT.md ops tables)
# with one-line purpose. Full grep: search server/src for process.env
#
# Full rules: docs/ARCHITECTURE.md#strict-layer-boundaries-operational-policy
#             docs/DEPLOYMENT.md#environment-layers-infrastructure-vs-ops-overrides
#
# --- Documented ops exceptions (product-adjacent; not secrets) ---
# These read process.env but tune behavior that would otherwise live only in CONFIG. Use for incidents or
# gradual rollout without a deploy; defaults remain in server/src/config (SYSTEM_DEFAULTS, model.ts, sentry.ts).
#   PIPELINE_CLAUDE_MODEL_ID / ANTHROPIC_MODEL — pipeline model id (see below).
#   SENTRY_DSN — infra secret; SENTRY_TRACES_SAMPLE_RATE — sampling (default: observability.sentryTracesSampleRateDefault).

# --- Core: connectivity & secrets (typical every deployment) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
ANTHROPIC_API_KEY=sk-ant-...
# Optional: Anthropic-compatible API base URL (corporate proxy / regional gateway). Omit for SDK default.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# Ops: skip writing `evaluation_datasets` rows when the table is not migrated (default: inserts enabled).
# EVALUATION_DATASETS_INSERT=false
# When true, evaluation_datasets inserts require audit owner's explicit evaluation_internal consent.
# EVALUATION_DATASETS_REQUIRE_INTERNAL_CONSENT=true
#
# Ops exception: override pipeline Claude model id without a code change. Falls back to SYSTEM_DEFAULTS.pipelineModel.claudeModelId.
# PIPELINE_CLAUDE_MODEL_ID=claude-sonnet-4-20250514
# Alias for PIPELINE_CLAUDE_MODEL_ID (same precedence: PIPELINE_CLAUDE_MODEL_ID wins if both set).
# ANTHROPIC_MODEL=
PORT=3001
# Optional bind address (default 0.0.0.0 for Docker/Railway). Use 127.0.0.1 for local-only listen.
# LISTEN_HOST=0.0.0.0
NODE_ENV=development

# Consultant promotion on first login: Postgres table `consultant_email_allowlist` only
# (platform admins: GET/POST/DELETE /api/platform/consultant-allowlist).

# Deprecated — ignored at runtime. Copy UUIDs into platform_settings.legacy_platform_admin_user_ids or set profiles.is_platform_admin.
# If still set, the server logs platform_admin.env_deprecated_ignored at startup.
# PLATFORM_ADMIN_USER_IDS=

# --- Production wiring (URLs, CORS, snapshot IP hashing) ---
# Required when NODE_ENV=production: secret for hashing client IPs in snapshot_guest_sessions (no raw IPs stored).
# SNAPSHOT_GUEST_IP_SALT=generate-a-long-random-string
# CORS: comma-separated browser origins (scheme + host; optional port). Merged with FRONTEND_URL in production.
# ALLOWED_ORIGINS=https://www.example.com,https://example.com
# FRONTEND_URL=https://www.example.com
# Required when NODE_ENV=production: HTTPS marketing/site origin for crawler user-agents (no trailing slash).
# GLC_PUBLIC_SITE_URL=https://www.example.com
# Optional: hostname or https URL for PDF/report branding if GLC_PUBLIC_SITE_URL cannot be parsed (fix URL in prod instead).
# GLC_BRAND_HOST_FALLBACK=

# --- White-label: public JSON (no env for copy) ---
# Brand name, legal line, footer copy, optional support_email, sentinel URL: edit packages/glc-dev-brand-defaults/src/public-brand-defaults.v1.json
# (exposed at GET /api/public/brand). support_email null hides contact in the SPA; empty/omitted falls back to dev default in server config.
# No-public-website sentinel is `NO_PUBLIC_WEBSITE_URL` from `@glc/intake-core` (see packages/glc-dev-brand-defaults).

# --- Observability (optional) ---
# SENTRY_DSN=
# Ops exception: traces sample rate 0.0–1.0; unset uses SYSTEM_DEFAULTS.observability.sentryTracesSampleRateDefault
# SENTRY_TRACES_SAMPLE_RATE=0.2

# --- Optional integrations & multi-tenant Redis key prefix ---
# Optional dedicated Redis URL for Claude circuit-breaker shared state (falls back to RATE_LIMIT_REDIS_URL if unset).
# CLAUDE_CIRCUIT_REDIS_URL=redis://localhost:6379
# Optional prefix for Claude circuit-breaker Redis key when sharing Redis (default key cb:claude:failures).
# REDIS_KEY_PREFIX=mytenant
# Telegram alerts (optional). Override API host only if traffic must go through a proxy.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_API_BASE=https://api.telegram.org

# --- Governance / Phase 6–7 feature toggles (read via server/src/config/feature-flags.ts; do not read these keys ad hoc in services) ---
# ε-greedy agent variant selection (default off). When false, bandit reads/writes to `bandit_arm_performance` are skipped.
# FEATURE_BANDITS=true
# Auto-loop: targeted agent rerun when Decision Layer returns refine (default off).
# Set GLC_DEPLOYMENT_PROFILE to one of AUTO_LOOP_ALLOWED_MODES (default sandbox,internal). Do not rely on NODE_ENV for this gate.
# Legacy: NODE_ENV is honored only when it exactly matches a name in AUTO_LOOP_ALLOWED_MODES.
# AUTO_LOOP_ENABLED=true
# GLC_DEPLOYMENT_PROFILE=sandbox
# AUTO_LOOP_ALLOWED_MODES=sandbox,internal
# Disable public security.txt connector (RFC 9116) for security_compliance enrichment (default: enabled when unset).
# CONNECTOR_SECURITY_TXT_ENABLED=false
# Cross-phase causal DAG: persist claim edges, validate premise_refs, downstream invalidation (default off).
# FEATURE_CAUSAL_DAG=true
# Auto-remediation: deterministic tone fixes on cleaned domain output when Decision Layer accepts (default off).
# FEATURE_AUTO_REMEDIATION=true
# Domain benchmarks: GET /api/benchmarks, pipeline context.benchmark_reference_id (default off).
# FEATURE_BENCHMARKS=true
# Strategy Lab: POST /api/audits/:id/strategy/execution-pack (extra Claude call; default on when unset).
# FEATURE_STRATEGY_EXECUTION_PACK=false
# GLC Orchestrator: optional LLM pass for conflict narrative on persisted pack (default off; graph build is deterministic).
# FEATURE_ORCHESTRATION_CONFLICT_SYNTHESIS=true
# GLC Orchestrator: POST/GET /api/audits/:id/orchestration/pack (default on when unset; set false to disable API only).
# FEATURE_ORCHESTRATION_PACK_API=false
# Post–MVP (v9) orchestration UX — see docs/adrs/ADR-ORCHESTRATION-POST-MVP-V9-CRITICAL-DELTA.md
# Dual manifest preview / scenario compare (server memo when enabled).
# FEATURE_MANIFEST_SCENARIO_COMPARE=true
# Consultant cockpit governance CTAs on POST pack (govern_action). SPA: consultantGovernanceCtasEnabled.
# FEATURE_CONSULTANT_GOVERNANCE_CTAS=true
# Anthropic prompt cache on stable prefixes (orchestration synthesis, agents, execution pack). Server default in SYSTEM_DEFAULTS; override for incidents.
# FEATURE_LLM_PROMPT_CACHE=true
# Plan-level control_object in pack JSON (ADR V4). **GA only after ADR Accepted** — also set planControlObjectUiEnabled in app-feature-flags when promoting.
# FEATURE_PLAN_CONTROL_OBJECT=true
# Delivery Board (`/plan?view=board`) rollout — mirrors SPA `planDeliveryBoardRolloutMode` (see orchestration-contract-parity.test.ts).
# FEATURE_PLAN_DELIVERY_BOARD_ROLLOUT_MODE=ga
# Optional shorthand when FEATURE_PLAN_DELIVERY_BOARD_ROLLOUT_MODE is omitted: `true` → internal, `false` → shadow (`getPlanDeliveryBoardRolloutMode` in feature-flags.ts).
# PLAN_DELIVERY_BOARD=false
# Strict appendix §2.3: forbid manual backlog cards from entering workflow column **in_progress** (PATCH moves + POST …/cards). Default **true** in SYSTEM_DEFAULTS; set false to relax.
# FEATURE_PLAN_BOARD_STRICT_MANUAL_IN_PROGRESS=false
# Pack-persist reconcile: single Postgres RPC transaction + advisory lock (`078_plan_board_reconcile_apply_batch`). Default **true**; set false to force legacy multi-call apply (incident rollback).
# FEATURE_PLAN_BOARD_RECONCILE_TRANSACTIONAL_APPLY=false
# Board lane/owner drafts → merged on Save manifest (`POST …/roadmap/manifest-snapshots`); blocks PATCH lane on plan board when on. Default on in SYSTEM_DEFAULTS; set false to rollback.
# FEATURE_MANIFEST_DRAFT_REVISIONS_FROM_BOARD=false
# FEATURE_PLAN_BOARD_RECONCILE_DIFF_PREVIEW=true — dry-run POST …/plan/board/reconcile/preview (off by default in SYSTEM_DEFAULTS).
# Per-audit custom board column ids (Epic 3). Default off; requires audit owner `profiles.plan_board_custom_columns_entitled`.
# FEATURE_PLAN_BOARD_CUSTOM_COLUMNS=true
# Auto-persist orchestration pack after strategy phase when latest roadmap manifest snapshot exists (default off).
# FEATURE_ORCHESTRATION_PACK_AUTO_AFTER_STRATEGY=true
# Timeline-first UX: structured KPI logs on GET /api/audits/:id/timeline (default on when unset).
# FEATURE_ORCHESTRATION_TIMELINE_PRIMARY_UX=false
# Director slice from domain-agent output (glc_director_execution). Required for strict pipeline phases 1,2,4,5,6 when unset defaults to off — enable for local runs or prod after contract validation.
# FEATURE_DIRECTOR_ORCHESTRATION_AGENT_OUTPUT=true
# Diagnostic Adaptive Intake pilot: default off in SYSTEM_DEFAULTS; set true only after Product/Ops handshake (docs/DEPLOYMENT.md).
# FEATURE_DIAGNOSTIC_INTAKE_PILOT=true
# Post-KPI train 1: execution-plan domain slice for in-scope coverage gaps — requires pilot flag AND KPI checkpoint expand (do not enable prematurely).
# FEATURE_EXECUTION_PLAN_COVERAGE_SCOPE=true
# Post-KPI train 4: include normalized intake project context envelope in ContextBuilder payload.
# FEATURE_PROJECT_CONTEXT_ENVELOPE=true
# Secret for POST /api/benchmarks/recompute (cron). Required length must match header value for timing-safe compare.
# BENCHMARK_RECOMPUTE_SECRET=

# --- Recommended runtime profiles for ADR-governed features ---
# Sandbox/Internal validation profile:
#   FEATURE_BANDITS=true
#   AUTO_LOOP_ENABLED=true
#   GLC_DEPLOYMENT_PROFILE=sandbox
#   FEATURE_DIRECTOR_ORCHESTRATION_AGENT_OUTPUT=true
#   FEATURE_CAUSAL_DAG=true
#   FEATURE_AUTO_REMEDIATION=true
#   FEATURE_BENCHMARKS=true  (only when migration 056 + recompute job are active)
#
# Conservative production profile (default-safe):
#   FEATURE_BANDITS=false
#   AUTO_LOOP_ENABLED=false
#   FEATURE_CAUSAL_DAG=false
#   FEATURE_AUTO_REMEDIATION=false
#   FEATURE_BENCHMARKS=false
#   FEATURE_STRATEGY_EXECUTION_PACK=true
# Enable each flag in production only with matching migration, runbook, and smoke coverage.

{
  "name": "glc-audit-server",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=9.15.0"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "playwright:install": "playwright install chromium",
    "seed-demo": "tsx scripts/seed-demo.ts",
    "intake-plan-debug": "tsx scripts/intake-plan-debug.ts",
    "intake-plan-benchmark": "tsx scripts/intake-plan-perf-benchmark.ts",
    "question-bank-overview": "tsx scripts/question-bank-overview.ts",
    "embed-question-bank-answers": "tsx scripts/embed-question-bank-answers.ts",
    "ingest:wappalyzer": "node scripts/ingest-webappalyzer.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@axe-core/playwright": "^4.11.1",
    "@react-pdf/renderer": "^4.3.2",
    "@sentry/node": "^9.47.1",
    "@supabase/supabase-js": "^2.49.0",
    "cheerio": "^1.0.0",
    "chrome-launcher": "^1.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "fast-xml-parser": "^5.5.11",
    "lighthouse": "11.7.1",
    "playwright": "^1.50.0",
    "rate-limit-redis": "^4.3.1",
    "react": "^18.3.1",
    "redis": "^5.11.0",
    "robots-parser": "^3.0.1",
    "yaml": "^2.8.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.12.0",
    "@types/react": "^18.3.18",
    "@vitest/coverage-v8": "^4.1.2",
    "fast-check": "^4.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "6.3.5",
    "vitest": "^4.1.0"
  }

{
  "name": "glc-audit-web",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "typecheck": "pnpm --filter glc-audit-server run typecheck",
    "lint": "eslint .",
    "audit:hardcode": "bash scripts/hardcode-inventory.sh",
    "audit:hardcode:metrics": "node scripts/hardcode-metrics.mjs",
    "audit:ds:raw-values": "node scripts/design-system-raw-values-check.mjs",
    "audit:ds:raw-values:ui": "DS_RAW_SCOPE=ui node scripts/design-system-raw-values-check.mjs",
    "audit:ds:raw-values:app": "DS_RAW_SCOPE=app node scripts/design-system-raw-values-check.mjs",
    "audit:ds:enforcement": "node scripts/design-system-enforcement-check.mjs",
    "audit:ds:enforcement:ds": "DS_ENFORCEMENT_SCOPE=ds node scripts/design-system-enforcement-check.mjs",
    "audit:ds:enforcement:ui": "DS_ENFORCEMENT_SCOPE=ui node scripts/design-system-enforcement-check.mjs",
    "audit:ds:enforcement:app": "DS_ENFORCEMENT_SCOPE=app node scripts/design-system-enforcement-check.mjs",
    "audit:ds:ts-color": "node scripts/design-system-ts-color-literals-check.mjs",
    "audit:ds:primitive-boundary": "node scripts/design-system-primitive-boundary-check.mjs",
    "audit:ds:patterns-lock": "node scripts/design-system-patterns-lock-check.mjs",
    "audit:ds:runtime": "node scripts/design-system-runtime-ci.mjs",
    "audit:ds:ci": "node scripts/design-system-runtime-ci.mjs",
    "audit:ds:migration-gate": "pnpm run audit:ds:raw-values:app && pnpm run audit:ds:enforcement:app && pnpm run audit:ds:ts-color && pnpm run audit:ds:primitive-boundary && pnpm run audit:ds:patterns-lock",
    "audit:ds:migration-report": "node scripts/design-system-export-violations.mjs",
    "audit:ds:export-violations": "node scripts/design-system-export-violations.mjs",
    "audit:ds:drift-budget": "node scripts/design-system-drift-budget-check.mjs",
    "audit:ds:drift-budget:record": "node scripts/design-system-drift-budget-check.mjs --record",
    "audit:ds:inventory-dump": "node scripts/design-system-inventory-dump.mjs",
    "audit:ds:refresh-allowlist": "node scripts/design-system-refresh-allowlist.mjs",
    "audit:ds:refresh-primitive-boundary-allowlist": "node scripts/design-system-refresh-primitive-boundary-allowlist.mjs",
    "audit:bank-copy": "node scripts/question-bank-copy-overlap.mjs",
    "test:intake-quality-report": "pnpm -w exec vitest run packages/intake-core/src/tests/intake-question-quality-report.test.ts",
    "lint:intake-readiness-vocab": "node scripts/intake-readiness-vocab-check.mjs",
    "test:intake-diagnostic-contracts": "pnpm vitest run packages/intake-core/src/tests/intake-diagnostic-readiness.test.ts packages/intake-core/src/tests/reorder-next-recommended-for-signal-priority.test.ts packages/intake-core/src/tests/evaluate-remediation-pilot.test.ts packages/intake-core/src/tests/intake-version-tuple.test.ts packages/intake-core/src/tests/lint-sequencing-pilot-guardrails.test.ts packages/intake-core/src/tests/intake-surface-no-regression.snapshot.test.ts packages/intake-core/src/tests/evaluate-pilot-kpi-gate.test.ts packages/intake-core/src/tests/phase-bc-expansion-order.test.ts packages/intake-core/src/tests/intake-readiness-execution-scope.test.ts packages/intake-core/src/tests/intake-yagni-deferred-modes.test.ts packages/intake-core/src/tests/phase-bc-context-envelope.test.ts packages/intake-core/src/tests/readiness-package-scope.matrix.test.ts packages/intake-core/src/tests/context-envelope-contract.test.ts && pnpm --filter glc-audit-server test -- src/services/pipeline-routes/__tests__/pipeline-route.use-cases.test.ts src/services/pipeline-routes/use-cases/__tests__/intake-readiness-preflight-modes.test.ts src/tests/build-brief-schema-snapshot.test.ts src/tests/intake-frozen-artifacts.test.ts src/tests/discover-route.test.ts src/tests/discover-convert-readiness-yagni.test.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm test && pnpm --filter glc-audit-server run test"
  },

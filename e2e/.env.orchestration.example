# Copy to your shell or a local .env (do not commit secrets).
# See e2e/README.md and ADR-ORCHESTRATION-POST-MVP-V9-CRITICAL-DELTA.md

# Required for non-skipping orchestration API specs:
# E2E_ORCHESTRATION_AUDIT_ID=
# E2E_ORCHESTRATION_AUTH_TOKEN=

# API origin for Vite /api proxy in CI (must match the API that issued the token):
# VITE_API_URL=https://api.example.com

# Consultant UI tests (stale banner, cockpit):
# E2E_CONSULTANT_E2E_EMAIL=
# E2E_CONSULTANT_E2E_PASSWORD=
#
# Client portal UI (canonical plan redirects under /portal/*):
# E2E_PORTAL_E2E_EMAIL=
# E2E_PORTAL_E2E_PASSWORD=
# Optional audit id override (defaults to E2E_ORCHESTRATION_AUDIT_ID):
# E2E_PORTAL_PLAN_AUDIT_ID=
#
# With E2E_ORCHESTRATION_UI + audit id + consultant email/password, also enables:
# - orchestration-plan-legacy-canonical.spec.ts (/roadmap|/timeline → /plan in the SPA)

# Optional: force KPI JSON output from Playwright
# E2E_ORCHESTRATION_JSON=1

# Optional: fail CI if creds are set but every orchestration spec skipped
# E2E_ORCHESTRATION_STRICT=1

# CI sets this for UI-heavy orchestration specs (see .github/workflows/test.yml)
# E2E_ORCHESTRATION_UI=1

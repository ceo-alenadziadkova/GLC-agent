          {
            "kind": "any",
            "of": [
              { "kind": "string_includes", "value": "painful" },
              { "kind": "string_includes", "value": "rarely" }
            ]
          }
        ]
      },
      {
        "then": "no",
        "if": [
          {
            "kind": "any",
            "of": [
              { "kind": "string_eq", "value": "no" },
              { "kind": "string_starts_with", "value": "no " }
